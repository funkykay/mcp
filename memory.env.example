# Placeholders are expanded by scripts/prepare.py into private memory.env.
export MCP_MEMORY_STORAGE_BACKEND='sqlite_vec'
export MCP_MEMORY_SQLITE_PATH='@HOME@/Library/Application Support/mcp-memory-service/memory.db'
export MCP_MEMORY_USE_ONNX='true'
export MCP_EMBEDDING_MODEL='paraphrase-multilingual-MiniLM-L12-v2'
export MCP_MEMORY_ONNX_PROVIDERS='CPUExecutionProvider'
